# Base Model Configuration
# Can be google/flan-t5-base, google/flan-t5-small, facebook/bart-base, mistralai/Mistral-7B-v0.1, etc.
BASE_MODEL_NAME=google/flan-t5-base

# Hugging Face Access Token (optional for open models, required for gated models like LLaMA-3 / Mistral)
HF_TOKEN=your_huggingface_token_here

# Hyperparameters for Fine-Tuning
LEARNING_RATE=3e-4
UNSTABLE_LEARNING_RATE=1e-1
NUM_EPOCHS=3
BATCH_SIZE=4
MAX_SOURCE_LENGTH=512
MAX_TARGET_LENGTH=128
WEIGHT_DECAY=0.01
WARMUP_RATIO=0.1
GRADIENT_ACCUMULATION_STEPS=1

# LoRA (PEFT) Hyperparameters
LORA_RANK=16
LORA_ALPHA=32
LORA_DROPOUT=0.05
TARGET_MODULES=q,v

# Data & Output Paths
DATA_DIR=data
RESULTS_DIR=results
OUTPUT_DIR=output
